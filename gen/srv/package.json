{
  "name": "sap-btp-enterprise-extension",
  "version": "1.0.0",
  "dependencies": {
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap-cloud-sdk/resilience": "^4.9.1",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "northwind_metadata": {
        "kind": "odata-v4",
        "model": "srv/external/northwind-metadata",
        "credentials": {
          "destination": "Northwind",
          "path": "/V4/Northwind/Northwind.svc/"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      }
    }
  },
  "engines": {
    "node": ">=20"
  }
}